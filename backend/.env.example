DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=abacus_db
DB_USERNAME=root
DB_PASSWORD=

JWT_SECRET=change_this_secret
JWT_TTL_SECONDS=604800

BASE_URL=https://api.simpleabacus.com
CORS_ORIGIN=https://simpleabacus.com,https://www.simpleabacus.com,http://localhost:5173,http://localhost:8080,http://127.0.0.1:5173,http://127.0.0.1:8080,https://*.simpleabacus.com

DEMO_NOTIFICATION_EMAIL=simpleabacuspune@gmail.com
FRANCHISE_NOTIFICATION_EMAIL=simpleabacuspune@gmail.com
INSTRUCTOR_NOTIFICATION_EMAIL=simpleabacuspune@gmail.com

MAIL_FROM_ADDRESS=no-reply@simpleabacus.com

# Instructor email delivery. Prefer BREVO_API_KEY on live servers because many
# shared hosts block outbound SMTP ports. If BREVO_API_KEY is empty, SMTP is used.
EMAIL_ENABLED=true
EMAIL_TIMEOUT_SECONDS=5
EMAIL_FROM="Simple Abacus <no-reply@simpleabacus.com>"
BREVO_API_KEY=
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_ALLOW_PHP_MAIL_FALLBACK=false

PAYMENT_PROVIDER=razorpay

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

SUBSCRIPTION_REMINDER_CRON_TOKEN=change_me_secure_token
REMINDER_SMS_FALLBACK_TO=
SMS_API_URL=
SMS_API_KEY=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
